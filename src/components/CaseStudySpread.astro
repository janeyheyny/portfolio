---
import CaseStudyTags from './CaseStudyTags.astro';

interface ContentSection {
  id: string;
  heading: string;
  paragraphs?: string[];
}

interface CaseStudyItem {
  title: string;
  headline: string;
  description: string;
  image: string;
  images: string[];
  techTags: string[];
  designTags?: string[];
  siteHref?: string;
  content: ContentSection[];
}

interface Props {
  item: CaseStudyItem;
}

const { item } = Astro.props;

// Resolve the 3 image slots:
// slot 0: images[0] ?? item.image; slot 1: images[1]; slot 2: images[2]
const imageSlots = [
  item.images?.[0] || item.image,
  item.images?.[1] || null,
  item.images?.[2] || null,
];

const contentSections = item.content.filter((s) => s.paragraphs && s.paragraphs.length > 0);
---

<article class="case-study-spread" data-case-study-spread>

  <!-- Top row: title + external link -->
  <div class="case-study-spread__top">
    <h2 class="case-study-spread__title">{item.title}</h2>
    {item.siteHref && (
      <a
        class="case-study-spread__link"
        href={item.siteHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visit ${item.title} website`}
      >
        <svg
          class="case-study-spread__link-icon"
          viewBox="0 0 20 20"
          width="20"
          height="20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M11 3H17V9"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M17 3L8 12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M9 5H4C3.44772 5 3 5.44772 3 6V16C3 16.5523 3.44772 17 4 17H14C14.5523 17 15 16.5523 15 16V11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )}
  </div>

  <!-- Tags -->
  <CaseStudyTags techTags={item.techTags} designTags={item.designTags} />

  <!-- Images grid -->
  <div class="case-study-spread__images">
    {imageSlots.map((src, i) => (
      <div class={`case-study-spread__image-slot case-study-spread__image-slot--${i + 1}`}>
        {src ? (
          <img src={src} alt="" class="case-study-spread__image" loading="lazy" />
        ) : (
          <div class="case-study-spread__image-placeholder" aria-hidden="true"></div>
        )}
      </div>
    ))}
  </div>

  <!-- Footer: headline + toggle -->
  <div class="case-study-spread__footer">
    <div class="case-study-spread__headline">
      <span class="case-study-spread__headline-text">{item.headline}</span>
      {' '}
      <span class="case-study-spread__description">{item.description}</span>
    </div>
    <button
      class="case-study-spread__toggle"
      data-spread-toggle
      aria-expanded="false"
    >
      <span class="case-study-spread__toggle-text">See more</span>
      <svg
        class="case-study-spread__toggle-icon"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <polyline
          points="6 9 12 15 18 9"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>

  <!-- Expanded content -->
  <div class="case-study-spread__content">
    <div class="case-study-spread__content-inner">
      {contentSections.map((section) => (
        <div class="case-study-spread__section">
          <h3 class="case-study-spread__section-heading">{section.heading}</h3>
          {section.paragraphs!.map((para) => (
            <p class="case-study-spread__paragraph">{para}</p>
          ))}
        </div>
      ))}
    </div>
  </div>

  <hr class="case-study-spread__divider" />

</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-case-study-spread]').forEach((article) => {
    const toggle = article.querySelector<HTMLButtonElement>('[data-spread-toggle]');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const isExpanded = article.classList.toggle('case-study-spread--expanded');
      toggle.setAttribute('aria-expanded', String(isExpanded));

      const textEl = toggle.querySelector('.case-study-spread__toggle-text');
      if (textEl) {
        textEl.textContent = isExpanded ? 'See less' : 'See more';
      }
    });
  });
</script>
