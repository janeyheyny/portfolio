---
import projects from "../data/projects.json";
import home from "../data/home.json";
import references from "../data/references.json";
import timeline from "../data/timeline.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import References from "../components/References.astro";
import Section from "../components/Section.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Timeline from "../components/Timeline.astro";
import CaseStudy from "../components/CaseStudyCard.astro";
import caseStudies from "../data/caseStudies.json";
import Contact from "../components/Contact.astro";
---

<Layout>
  <Header nav={home.nav} />

  <main>
    <Hero hero={home.hero} references={references} />

    <Services services={home.services} />

    <CaseStudy caseStudies={caseStudies.caseStudies} />

    <Projects projects={projects} />

    <Skills skills={home.skills} />

    <Timeline id="experience" title="Education and Experience" items={timeline} />

    <Contact email="heynjane@gmail.com" />

</Layout>
