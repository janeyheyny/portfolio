---
const { skills } = Astro.props;
---

<section class="section skills" id={skills.id}>
  <div class="container">
    <h2 class="section__title">{skills.title}</h2>
    <p class="skills__intro">{skills.intro}</p>
    <div class="skills__bubbles">
      {skills.bubbles.map((bubble: { title: string; items: string[] }) => (
        <div class="skills__bubble" data-bubble tabindex="0">
          <div class="skills__bubble-inner">
            <span class="skills__bubble-title">{bubble.title}</span>
            <ul class="skills__bubble-list">
              {bubble.items.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/skills';
</script>
