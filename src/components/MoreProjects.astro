---
import CaseStudyTags from './CaseStudyTags.astro';

interface ProjectItem {
  name: string;
  description: string;
  image: string;
  href?: string;
  techTags: string[];
  designTags: string[];
  class: string;
}

interface Props {
  projects: {
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;
---

<section class="section more-projects">
  <h2 class="more-projects__title container">More projects</h2>
  <div class="container">
    <div class="more-projects__grid">
      {projects.items.map((item) => (
        <div class="more-projects__card">
          <div class="more-projects__image-wrap">
            <img
              src={item.image}
              alt={item.name}
              class="more-projects__image"
              loading="lazy"
            />
            {item.href && (
              <a
                class="more-projects__link"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${item.name} website`}
              >
                <img src="/images/icon-link.svg" alt="" aria-hidden="true" />
              </a>
            )}
          </div>
          <div class="more-projects__body">
            {item.href ? (
              <a
                class="more-projects__name more-projects__name--link"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
              >{item.name}</a>
            ) : (
              <p class="more-projects__name">{item.name}</p>
            )}
            <p class="more-projects__description">{item.description}</p>
            <CaseStudyTags techTags={item.techTags} designTags={item.designTags} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
